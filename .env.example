# =============================================================================
# AI Developer OS — Environment Configuration Template
# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider
# Choose one: "gemini" | "openai" | "anthropic"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google Gemini (google-generativeai)
# Get key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro-latest

# ---------------------------------------------------------------------------
# OpenAI
# Get key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Anthropic Claude
# Get key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Database — PostgreSQL + pgvector
# Provision your own PostgreSQL 15+ with pgvector extension, or use Docker
# Compose (docker-compose up db) to spin up a local instance.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://aideveloper:yourpassword@localhost:5432/aideveloperos
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# GitHub App / OAuth Integration
# Create a GitHub App: https://github.com/settings/apps/new
# ---------------------------------------------------------------------------
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ---------------------------------------------------------------------------
# Docker Sandbox
# Ensure Docker Engine is running. The sandbox image is built from
# sandbox/docker/Dockerfile.sandbox
# ---------------------------------------------------------------------------
SANDBOX_DOCKER_IMAGE=ai-developer-os/sandbox:latest
SANDBOX_EXECUTION_TIMEOUT=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# FastAPI Backend
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Security
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-secure-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Storage / Observability
# ---------------------------------------------------------------------------
MEMORY_STORAGE_PATH=.memory
OBSERVABILITY_STORAGE_PATH=.observability
EVALUATION_STORAGE_PATH=.evaluation
